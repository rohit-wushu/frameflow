# Copy to .env and fill in. Never commit .env.

# AI director (phase 2)
ANTHROPIC_API_KEY=
DIRECTOR_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (claude-opus-5-5 defaults to medium)
DIRECTOR_EFFORT=medium

# Python audio service (services/audio)
AUDIO_SERVICE_URL=http://127.0.0.1:8790

# Where generated files go (local dev storage)
STORAGE_DIR=./storage

# Web app (phase 3): Postgres (Prisma) and Redis (BullMQ)
DATABASE_URL=postgresql://USER@127.0.0.1:5432/frameflow
# a separate Redis database number keeps Frameflow's queues apart from other apps
REDIS_URL=redis://127.0.0.1:6379/5
# public address of the web app (cookies are Secure when it starts with https)
APP_URL=http://localhost:3210
# monthly limits per account tier (renders include edits); see packages/db/src/limits.ts
FREE_RENDERS_PER_MONTH=10
PRO_RENDERS_PER_MONTH=200
# director calls (new plans + chat edits) per user per day
AI_CALLS_PER_DAY=40
# only on a dev machine: let brand research open private/local addresses
# ALLOW_PRIVATE_URLS=1
