# Copy to .env and fill in. Never commit .env.

# AI director (phase 2)
ANTHROPIC_API_KEY=
DIRECTOR_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (claude-opus-5-5 defaults to medium)
DIRECTOR_EFFORT=medium

# Python audio service (services/audio)
AUDIO_SERVICE_URL=http://127.0.0.1:8790

# Where generated files go (local dev storage)
STORAGE_DIR=./storage

# Web app (phase 3): Postgres (Prisma) and Redis (BullMQ)
DATABASE_URL=postgresql://USER@127.0.0.1:5432/frameflow
# a separate Redis database number keeps Frameflow's queues apart from other apps
REDIS_URL=redis://127.0.0.1:6379/5
# public address of the web app (cookies are Secure when it starts with https)
APP_URL=http://localhost:3210
# monthly limits per account tier (renders include edits); see packages/db/src/limits.ts
FREE_RENDERS_PER_MONTH=10
PRO_RENDERS_PER_MONTH=200
# director calls (new plans + chat edits) per user per day
AI_CALLS_PER_DAY=40
# only on a dev machine: let brand research open private/local addresses
# ALLOW_PRIVATE_URLS=1

# Admins (comma-separated emails): they see the admin panel at /admin. More admins can be added from the panel.
ADMIN_EMAILS=

# Email (verification + password reset) over SMTP, e.g. smtps://user:password@smtp.zoho.in:465
# Without it, dev prints emails (with their links) to the web app's console; production refuses to send.
SMTP_URL=
MAIL_FROM="Frameflow <support@example.com>"

# Razorpay (Dashboard → Account & Settings → API keys; use test keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks: URL <APP_URL>/api/razorpay/webhook, events payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=
# the Pro pass: one payment = PRO_DAYS of Pro, no auto-renewal
PRO_PRICE_INR=999
PRO_DAYS=30

# Business details for the Terms / Privacy / Refunds / Contact pages (Razorpay checks these)
LEGAL_NAME=
LEGAL_ADDRESS=
CONTACT_EMAIL=
CONTACT_PHONE=
LEGAL_JURISDICTION=
